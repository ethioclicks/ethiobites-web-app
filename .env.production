# Production Environment Variables
# Copy this file to .env.local and update with your production values

# Application
NODE_ENV=production

# API Configuration
NEXT_PUBLIC_API_URL=https://sea-lion-app-kunmz.ondigitalocean.app

# NextAuth Configuration
NEXTAUTH_URL=https://app.ethiobites.com
NEXTAUTH_SECRET=your-super-secure-secret-key-at-least-32-characters-long

# Firebase Configuration (Production)
NEXT_PUBLIC_FIREBASE_API_KEY=your-production-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-production-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Security (Optional - for additional security measures)
SECURITY_HEADERS_ENABLED=true
CSP_REPORT_URI=https://your-domain.report-uri.com/r/d/csp/enforce

# Analytics (Optional)
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Logging (Optional)
LOG_LEVEL=error
SENTRY_DSN=https://your-sentry-dsn

# Performance Monitoring (Optional)
PERFORMANCE_MONITORING_ENABLED=true

# Rate Limiting (Optional - if using custom rate limiting)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000