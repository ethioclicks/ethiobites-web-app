{
  "name": "ethobites-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "build:analyze": "ANALYZE=true npm run build",
    "preview": "npm run build && npm run start",
    "clean": "rm -rf .next out",
    "docker:build": "docker build -t ethobites/web-app .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local ethobites/web-app",
    "deploy": "./scripts/deploy.sh",
    "deploy:compose": "./scripts/deploy.sh compose",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "audit:security": "npm audit --audit-level moderate",
    "test": "echo \"Warning: no test specified\" && exit 0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "@eslint/eslintrc": "^3.3.1",
    "eslint-config-next": "^16.3.1",
    "firebase": "^12.17.1",
    "next": "^16.3.1",
    "next-auth": "^4.24.15",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  }
}
