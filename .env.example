# Environment Variables Example
# Copy this file to .env.local and update with your actual values

# Application
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=https://ethiobite.com

# Public menu base URL for QR code links (production domain).
# Leave unset for local dev to fall back to the current origin.
NEXT_PUBLIC_MENU_BASE_URL=https://ethiobite.com

# NextAuth Configuration
NEXTAUTH_URL=https://ethiobite.com
NEXTAUTH_SECRET=your-secret-key-here

# Supabase Configuration (Primary storage - same as mobile app)
NEXT_PUBLIC_SUPABASE_URL=https://wvveitdbktlvigdsxscd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key